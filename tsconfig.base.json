{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@entry/design-token": ["libs/design-token/src/index.ts"],
      "@entry/design-token/*": ["libs/design-token/src/*"],
      "@entry/hooks": ["libs/hooks/src/index.ts"],
      "@entry/hooks/*": ["libs/hooks/src/*"],
      "@entry/ui": ["libs/ui/src/index.ts"],
      "@entry/ui/*": ["libs/ui/src/*"],
      "@entry/util-config": ["libs/utils-config/src/index.ts"],
      "@entry/util-config/*": ["libs/utils-config/src/*"]
    }
  }
}
